#define DEFAULT 0
#define WIN     1
#define NUM     2
#define SYM     3
#define FUN     4
#define MOUSE   5
#define SCROLL  6
#define NONE    7

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
    hold-trigger-key-positions = <>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

&msc {
    trigger-period-ms = <32>;
    time-to-max-speed-ms = <0>;
};

/ {
    // custom shift using mod-morph

    behaviors {
        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        OFF {
            bindings = <&to 7>;
            key-positions = <30 38>;
            layers = <0>;
        };

        ON {
            bindings = <&to 0>;
            key-positions = <30 38>;
            layers = <7>;
        };

        WINDOWS {
            bindings = <&to 0>;
            key-positions = <0 9>;
            layers = <0>;
        };

        MAC {
            bindings = <&to 0>;
            key-positions = <0 9>;
            layers = <7>;
        };

        LEFT_CLICK {
            bindings = <&mkp LCLK>;
            key-positions = <0 1>;
        };

        RIGHT_CLICK {
            bindings = <&mkp RCLK>;
            key-positions = <20 21>;
        };

        ENGLISH_KEY {
            bindings = <&kp F10>;
            key-positions = <6 7>;
        };
    };

    macros {
        macbook_1: macbook_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_wait_time 300>, <&bt BT_SEL 0>;

            label = "MACBOOK_1";
        };

        macmini_2: macmini_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_wait_time 300>, <&bt BT_SEL 1>;

            label = "MACMINI_2";
        };

        ipad_3: ipad_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_wait_time 300>, <&bt BT_SEL 2>;

            label = "IPAD_3";
        };

        windows_4: windows_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_wait_time 300>, <&bt BT_SEL 3>;

            label = "WINDOWS_4";
        };

        windows_5: windows_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_wait_time 300>, <&bt BT_SEL 4>;

            label = "WINDOWS_5";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_layer {
            label = "MAC";
            bindings = <
&lt 6 Q                    &kp W           &kp E  &kp R  &kp T                                     &kp Y       &kp U  &kp I            &kp O                 &kp P
&kp A                      &kp S           &kp D  &kp F  &kp G                                     &kp H       &kp J  &kp K            &kp L                 &lt 4 ENTER
&mt LEFT_SHIFT Z           &mt LEFT_ALT X  &kp C  &kp V  &kp B                                     &kp N       &kp M  &mt RCTRL COMMA  &mt RIGHT_ALT PERIOD  &kp BACKSPACE
&mt LS(LA(LG(LCTRL))) ESC                                &kp LEFT_COMMAND  &lt 3 SPACE  &lt 2 TAB  &kp RSHIFT  &none  &kp LANG2        &kp LANG1             &none
            >;
        };

        windows_layer {
            label = "WIN";
            bindings = <
&lt 6 Q           &kp W           &kp E  &kp R  &kp T                                     &kp Y       &kp U  &kp I            &kp O                 &kp P
&kp A             &kp S           &kp D  &kp F  &kp G                                     &kp H       &kp J  &kp K            &kp L                 &lt 4 ENTER
&mt LEFT_SHIFT Z  &mt LEFT_ALT X  &kp C  &kp V  &kp B                                     &kp N       &kp M  &mt RCTRL COMMA  &mt RIGHT_ALT PERIOD  &kp BACKSPACE
&mt LCTRL ESC                                   &kp LEFT_COMMAND  &lt 3 SPACE  &lt 2 TAB  &kp RSHIFT  &none  &kp LANG2        &kp LANG1             &none
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
&kp KP_NUMBER_1        &kp KP_NUMBER_2         &kp KP_NUMBER_3  &kp KP_NUMBER_4   &kp KP_NUMBER_5                       &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMBER_0
&caps_word             &msc MOVE_X(20)         &msc MOVE_Y(20)  &msc MOVE_Y(-20)  &msc MOVE_X(-20)                      &kp LEFT_ARROW   &kp DOWN_ARROW   &kp UP_ARROW     &kp RIGHT_ARROW  &kp LA(GRAVE)
&kp LSHIFT             &mt LEFT_ALT LC(PG_UP)  &kp LC(PG_DN)    &mkp MB4          &mkp MB5                              &kp HOME         &kp PG_DN        &kp PG_UP        &kp END          &kp DELETE
&kp LS(LA(LG(LCTRL)))                                                             &kp LEFT_GUI      &lt 4 SPACE  &none  &kp TAB          &none            &none            &none            &none
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp EXCLAMATION        &kp AT_SIGN  &kp HASH   &kp DOLLAR         &kp PERCENT                      &kp CARET             &kp AMPERSAND          &kp ASTERISK      &kp MINUS          &kp PLUS
&kp QUESTION           &kp TILDE    &kp GRAVE  &kp DOUBLE_QUOTES  &kp SQT                          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp COLON
&kp UNDERSCORE         &kp PIPE     &kp BSLH   &kp FSLH           &kp SLASH                        &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LESS_THAN     &kp GREATER_THAN   &kp SEMI
&kp LS(LA(LG(LCTRL)))                                             &kp SPACE    &none  &lt 4 EQUAL  &kp RA(Y)             &none                  &none             &none              &none
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&kp F1                 &kp F2   &kp F3       &kp F4       &kp F5                       &kp F6      &kp F7      &kp F8   &kp F9      &kp F10
&kp F11                &kp F12  &kp LC(F13)  &kp LA(F13)  &kp LC(LS(S))                &macbook_1  &macmini_2  &ipad_3  &windows_4  &windows_5
&kp F20                &kp F14  &kp F15      &kp F16      &kp F17                      &bt BT_CLR  &none       &none    &none       &sys_reset
&kp LS(LA(LG(LCTRL)))                                     &none          &none  &none  &none       &none       &none    &none       &none
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&mkp MB1  &mkp MB1  &none  &none  &none                   &none   &none   &none   &none   &none
&mkp MB3  &mkp MB3  &none  &none  &none                   &none   &none   &none   &none   &none
&mkp MB2  &mkp MB2  &none  &none  &none                   &none   &none   &none   &none   &none
&none                             &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&none  &msc SCRL_LEFT  &msc SCRL_UP  &msc SCRL_DOWN  &msc SCRL_RIGHT                &none           &none           &none         &none            &none
&none  &none           &none         &none           &none                          &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
&none  &none           &none         &none           &none                          &none           &none           &none         &none            &none
&none                                                &none            &none  &none  &none           &none           &none         &none            &none
            >;
        };

        none_layer {
            label = "NONE";
            bindings = <
&none  &none  &none  &none  &none                &none  &none  &none  &none  &none
&none  &none  &none  &none  &none                &none  &none  &none  &none  &none
&none  &none  &none  &none  &none                &none  &none  &none  &none  &none
&none                       &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
