#define DEFAULT 0
#define WIN     1
#define NUM     2
#define SYM     3
#define FUN     4
#define MOUSE   5
#define SCROLL  6
#define SNIPE   7
#define NONE    8

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph

    behaviors {
        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        ENGLISH_KEY {
            bindings = <&kp F10>;
            key-positions = <6 7>;
        };

        OFF {
            bindings = <&to 9>;
            key-positions = <30 38>;
            layers = <0 2>;
        };

        ON {
            bindings = <&to 0>;
            key-positions = <30 38>;
            layers = <9 2>;
        };

        WINDOWS {
            bindings = <&to 2>;
            key-positions = <0 9>;
            layers = <0>;
        };

        MAC {
            bindings = <&to 0>;
            key-positions = <0 9>;
            layers = <9 2>;
        };

        TAB_KEY {
            bindings = <&kp TAB>;
            key-positions = <1 0>;
        };

        SHIFT_M_ON {
            bindings = <&to 1>;
            key-positions = <16 17>;
            layers = <0>;
        };

        SHIFT_M_OFF {
            bindings = <&to 0>;
            key-positions = <16 17>;
            layers = <1>;
        };

        SHIFT_W_ON {
            bindings = <&to 3>;
            key-positions = <16 17>;
            layers = <2>;
        };

        SHIFT_W_OFF {
            bindings = <&to 2>;
            key-positions = <16 17>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_layer {
            label = "MAC";
            bindings = <
&lt 8 Q                            &kp W  &kp E  &kp R  &kp T                                   &kp Y        &kp U           &kp I          &kp O    &kp P
&lt 6 A                            &kp S  &kp D  &kp F  &kp G                                   &kp H        &kp J           &kp K          &kp L    &lt 6 SEMICOLON
&mt LEFT_SHIFT Z                   &kp X  &kp C  &kp V  &kp B                                   &kp N        &kp M           &kp COMMA      &kp DOT  &mt LEFT_SHIFT MINUS
&mt LA(LC(LG(LEFT_SHIFT))) ESCAPE                       &kp LGUI  &lt 5 SPACE  &mt LCTRL LANG2  &lt 4 ENTER  &mt RALT LANG1  &kp BACKSPACE  &kp DEL  &kp LA(GRAVE)
            >;
        };

        shiftd_layer {
            label = "SHTM";
            bindings = <
&lt 8 LS(Q)                        &kp LS(W)  &kp LS(E)  &kp LS(R)  &kp LS(T)                                &kp RS(Y)    &kp RS(U)       &kp RS(I)      &kp RS(O)    &kp RS(P)
&lt 6 RS(A)                        &kp RS(S)  &kp LS(D)  &kp LS(F)  &kp LS(G)                                &kp RS(H)    &kp RS(J)       &kp RS(K)      &kp RS(L)    &lt 6 RS(SEMICOLON)
&kp RS(Z)                          &kp LS(X)  &kp LS(C)  &kp LS(V)  &kp LS(B)                                &kp RS(N)    &kp RS(M)       &kp RS(COMMA)  &kp RS(DOT)  &kp RS(MINUS)
&mt LA(LC(LG(LEFT_SHIFT))) ESCAPE                                   &kp LGUI   &lt 5 SPACE  &mt LCTRL LANG2  &lt 4 ENTER  &mt RALT LANG1  &kp BACKSPACE  &kp DELETE   &kp LA(GRAVE)
            >;
        };

        windows_layer {
            label = "WIN";
            bindings = <
&lt 8 Q           &kp W  &kp E  &kp R  &kp T                             &kp Y        &kp U           &kp I      &kp O       &kp P
&lt 6 A           &kp S  &kp D  &kp F  &kp G                             &kp H        &kp J           &kp K      &kp L       &lt 6 SEMICOLON
&mt LEFT_SHIFT Z  &kp X  &kp C  &kp V  &kp B                             &kp N        &kp M           &kp COMMA  &kp DOT     &mt LEFT_SHIFT MINUS
&mt LCTRL ESCAPE                       &kp LGUI  &lt 5 SPACE  &kp LANG2  &lt 4 ENTER  &mt RALT LANG1  &kp BSPC   &kp DELETE  &kp LA(GRAVE)
            >;
        };

        shiftw_layer {
            label = "SFTW";
            bindings = <
&lt 8 LS(Q)       &kp LS(W)  &kp LS(E)  &kp LS(R)  &kp LS(T)                                &kp RS(Y)    &kp RS(U)       &kp RS(I)      &kp RS(O)    &kp RS(P)
&lt 6 RS(A)       &kp RS(S)  &kp LS(D)  &kp LS(F)  &kp LS(G)                                &kp RS(H)    &kp RS(J)       &kp RS(K)      &kp RS(L)    &lt 6 RS(SEMICOLON)
&kp RS(Z)         &kp LS(X)  &kp LS(C)  &kp LS(V)  &kp LS(B)                                &kp RS(N)    &kp RS(M)       &kp RS(COMMA)  &kp RS(DOT)  &kp RS(MINUS)
&mt LCTRL ESCAPE                                   &kp LGUI   &lt 5 SPACE  &mt LCTRL LANG2  &lt 4 ENTER  &mt RALT LANG1  &kp BACKSPACE  &kp DEL      &kp LA(GRAVE)
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
&kp NUMBER_1                &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                        &kp LC(LEFT)        &kp LC(DOWN_ARROW)  &kp LC(UP_ARROW)  &kp LC(RIGHT_ARROW)  &kp HOME
&kp N6                      &kp N7        &kp N8        &kp N9        &kp N0                              &kp LEFT_ARROW      &kp DOWN_ARROW      &kp UP_ARROW      &kp RIGHT_ARROW      &kp PG_UP
&mt LEFT_SHIFT PERCENT      &kp FSLH      &kp ASTERISK  &kp PLUS      &kp EQUAL                           &kp LA(LEFT_ARROW)  &kp LA(DOWN_ARROW)  &kp LA(UP_ARROW)  &kp LA(RIGHT_ARROW)  &mt RIGHT_SHIFT PAGE_DOWN
&kp LA(LC(LG(LEFT_SHIFT)))                                            &kp LEFT_GUI  &kp SPACE  &kp RCTRL  &trans              &kp RIGHT_ALT       &kp RC(PG_UP)     &kp RC(PAGE_DOWN)    &kp END
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp EXCLAMATION             &kp AT_SIGN  &kp HASH           &kp DOLLAR        &kp PERCENT                    &kp CARET             &kp AMPERSAND          &kp ASTERISK      &kp PLUS           &kp EQUAL
&kp QUESTION                &kp GRAVE    &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &none                          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp COLON
&kp RA(SEMICOLON)           &kp RA(X)    &kp RA(EQUAL)      &kp RA(Y)         &kp LA(N8)                     &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LESS_THAN     &kp GREATER_THAN   &kp UNDERSCORE
&kp LA(LC(LG(LEFT_SHIFT)))                                                    &kp LGUI     &none  &kp TILDE  &kp EQUAL             &kp PLUS               &kp PIPE          &kp BSLH           &kp SLASH
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&kp F1                      &kp F2   &kp F3   &kp F4   &kp F5                                 &kp F13       &kp LA(F13)   &kp LS(LC(S))  &kp LA(LC(F13))  &kp F16
&kp F6                      &kp F7   &kp F8   &kp F9   &kp F10                                &caps_word    &kp LANG2     &kp LANG1      &kp GLOBE        &kp ESC
&kp F11                     &kp F12  &kp F13  &kp F14  &kp F15                                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3     &bt BT_CLR
&kp LA(LC(LG(LEFT_SHIFT)))                             &kp LS(LG(M))  &kp LS(LG(M))  &kp F17  &kp F18       &kp F19       &kp F20        &kp F21          &kp F22
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&none  &kp LC(PG_UP)  &none      &kp LC(PG_DN)  &none                   &none   &none   &none   &none   &none
&none  &mkp LCLK      &mkp MCLK  &mkp RCLK      &none                   &none   &none   &none   &none   &none
&none  &mkp MB4       &none      &mkp MB5       &none                   &none   &none   &none   &none   &none
&none                                           &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &msc SCRL_LEFT  &mmv MOVE_RIGHT  &trans          &trans                           &trans  &trans  &trans  &trans  &trans
&trans  &mmv MOVE_LEFT  &mmv MOVE_UP     &mmv MOVE_DOWN  &mmv MOVE_RIGHT                  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans           &trans          &trans                           &trans  &trans  &trans  &trans  &trans
&trans                                                   &trans           &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        none_layer {
            label = "NONE";
            bindings = <
&none  &none  &none  &none  &none                &none  &none  &none  &none  &none
&none  &none  &none  &none  &none                &none  &none  &none  &none  &none
&none  &none  &none  &none  &none                &none  &none  &none  &none  &none
&none                       &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
