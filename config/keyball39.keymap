#define DEFAULT 0
#define WIN     1
#define NUM     2
#define SYM     3
#define FUN     4
#define MOUSE   5
#define SCROLL  6
#define NONE    7

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
    hold-trigger-key-positions = <>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

&msc {
    trigger-period-ms = <32>;
    time-to-max-speed-ms = <0>;
};

/ {
    // custom shift using mod-morph

    behaviors {
        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        OFF {
            bindings = <&to 7>;
            key-positions = <30 38>;
            layers = <0>;
        };

        ON {
            bindings = <&to 0>;
            key-positions = <30 38>;
            layers = <7>;
        };

        WINDOWS {
            bindings = <&to 0>;
            key-positions = <0 9>;
            layers = <0>;
        };

        MAC {
            bindings = <&to 0>;
            key-positions = <0 9>;
            layers = <7>;
        };

        LEFT_CLICK {
            bindings = <&mkp LCLK>;
            key-positions = <13 12>;
        };

        RIGHT_CLICK {
            bindings = <&mkp RCLK>;
            key-positions = <11 12>;
        };
    };

    macros {
        macbook_1: macbook_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_wait_time 300>, <&bt BT_SEL 0>;

            label = "MACBOOK_1";
        };

        macmini_2: macmini_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_wait_time 300>, <&bt BT_SEL 1>;

            label = "MACMINI_2";
        };

        ipad_3: ipad_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_wait_time 300>, <&bt BT_SEL 2>;

            label = "IPAD_3";
        };

        windows_4: windows_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_wait_time 300>, <&bt BT_SEL 3>;

            label = "WINDOWS_4";
        };

        windows_5: windows_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_wait_time 300>, <&bt BT_SEL 4>;

            label = "WINDOWS_5";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_layer {
            label = "MAC";
            bindings = <
&lt 6 Q                  &kp W           &kp E  &kp R  &kp T                                 &kp Y        &kp U                      &kp I      &kp O                 &kp P
&kp A                    &kp S           &kp D  &kp F  &kp G                                 &kp H        &kp J                      &kp K      &kp L                 &kp ENTER
&mt LS(LA(LG(RCTRL))) Z  &mt LEFT_ALT X  &kp C  &kp V  &kp B                                 &kp N        &kp M                      &kp COMMA  &mt RIGHT_ALT PERIOD  &mt RCTRL MINUS
&none                                                  &mt LEFT_GUI SPACE  &lt 3 TAB  &none  &lt 2 ENTER  &mt RIGHT_SHIFT BACKSPACE  &kp LANG2  &kp LANG2             &none
            >;
        };

        windows_layer {
            label = "WIN";
            bindings = <
&lt 6 Q      &kp W           &kp E  &kp R  &kp T                                 &kp Y        &kp U                      &kp I      &kp O                 &kp P
&kp A        &kp S           &kp D  &kp F  &kp G                                 &kp H        &kp J                      &kp K      &kp L                 &kp ENTER
&mt RCTRL Z  &mt LEFT_ALT X  &kp C  &kp V  &kp B                                 &kp N        &kp M                      &kp COMMA  &mt RIGHT_ALT PERIOD  &mt RCTRL MINUS
&none                                      &mt LEFT_GUI SPACE  &lt 3 TAB  &none  &lt 2 ENTER  &mt RIGHT_SHIFT BACKSPACE  &kp LANG2  &kp LANG2             &none
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
&kp KP_NUMBER_1                  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5                      &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMBER_0
&caps_word                       &msc SCRL_LEFT   &msc SCRL_UP     &msc SCRL_DOWN   &msc SCRL_RIGHT                      &kp LEFT_ARROW   &kp DOWN_ARROW   &kp UP_ARROW     &kp RIGHT_ARROW  &kp LANG2
&mt RA(RC(RG(RIGHT_SHIFT))) ESC  &mkp MB4         &mkp MB5         &kp RC(PG_UP)    &kp LC(PAGE_DOWN)                    &kp HOME         &kp PG_DN        &kp PG_UP        &kp END          &kp RA(LANG1)
&none                                                                               &kp SPACE          &lt 4 TAB  &none  &none            &kp DEL          &kp F10          &kp RA(GRAVE)    &none
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH   &kp DOLLAR         &kp PERCENT                  &kp CARET             &kp AMPERSAND          &kp ASTERISK      &kp MINUS          &kp PLUS
&kp QUESTION     &kp TILDE    &kp GRAVE  &kp DOUBLE_QUOTES  &kp SQT                      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp COLON
&kp SEMI         &kp PIPE     &kp BSLH   &kp FSLH           &kp SPACE                    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LESS_THAN     &kp GREATER_THAN   &kp UNDERSCORE
&none                                                       &kp SPACE    &kp TAB  &none  &lt 4 EQUAL           &none                  &none             &none              &none
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&kp F1                     &kp F2   &kp F3       &kp F4       &kp F5                       &kp F6      &kp F7      &kp F8   &kp F9      &kp F10
&kp F11                    &kp F12  &kp LC(F13)  &kp LA(F13)  &kp LC(LS(S))                &macbook_1  &macmini_2  &ipad_3  &windows_4  &windows_5
&mt LS(LA(LG(LCTRL))) ESC  &kp F14  &kp F15      &kp F16      &kp F17                      &bt BT_CLR  &none       &none    &sys_reset  &none
&none                                                         &none          &none  &none  &none       &none       &none    &none       &bootloader
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&none  &kp LC(PG_UP)  &none      &kp LC(PG_DN)  &none                   &none   &none   &none   &none   &none
&none  &mkp RCLK      &mkp MCLK  &mkp LCLK      &none                   &none   &none   &none   &none   &none
&none  &mkp MB4       &none      &mkp MB5       &none                   &none   &none   &none   &none   &none
&none                                           &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&none  &msc SCRL_LEFT  &msc SCRL_UP  &msc SCRL_DOWN  &msc SCRL_RIGHT                &none           &none           &none         &none            &none
&none  &none           &none         &none           &none                          &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
&none  &none           &none         &none           &none                          &none           &none           &none         &none            &none
&none                                                &none            &none  &none  &none           &none           &none         &none            &none
            >;
        };

        none_layer {
            label = "NONE";
            bindings = <
&none  &none  &none  &none  &none                &none  &none  &none  &none  &none
&none  &none  &none  &none  &none                &none  &none  &none  &none  &none
&none  &none  &none  &none  &none                &none  &none  &none  &none  &none
&none                       &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
